# Verified backups and generated report artifacts.
# Keep Python source files under reports/ tracked.
/final_validation_backup/
/reports/*.pdf
/reports/*.pdf.tmp
/reports/.sessions/
/supabase/.temp/

# Runtime logs, temporary output, and generated exports
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.csv
*.xlsx
/exports/*
!/exports/.gitkeep
/build/
/dist/
/test_output/
/test_results/
/diagnostics/
/diagnostic_output/
/runtime/
/output/
/tmp/
/temp/

